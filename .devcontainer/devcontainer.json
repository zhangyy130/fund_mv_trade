{
  "name": "基金均值交易系统",
  "image": "mcr.microsoft.com/devcontainers/python:3.10",
  "forwardPorts": [8501],
  "postCreateCommand": "pip install -r requirements.txt && chmod +x .devcontainer/start.sh",
  "runCommand": ".devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  }
}
